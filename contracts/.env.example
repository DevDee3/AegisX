# Used by script/Deploy.s.sol and script/DeployMocks.s.sol.
# This is the admin/deployer key — separate from backend/.env's
# AGENT_PRIVATE_KEY (Phase 5), which must stay a low-privilege AGENT_ROLE key.
DEPLOYER_PRIVATE_KEY=

# Only needed for DeployMocks.s.sol (it grants the deployed registry
# TRUSTED/BLOCKED classifications). Set this to DeployCore's
# GuardianRegistry address after running DeployCore.
REGISTRY_ADDRESS=

# Only needed if you pass --verify to forge script.
SNOWTRACE_API_KEY=
