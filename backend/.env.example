NODE_ENV=development
PORT=8787

# Fuji testnet by default. Never point this at mainnet during development.
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
CHAIN_ID=43113

# Deployed Guardian contract addresses (from ../contracts). Leave unset and
# the backend still runs — registry checks just default to UNKNOWN.
GUARDIAN_REGISTRY_ADDRESS=
GUARDIAN_VAULT_ADDRESS=

# Optional. Without this, every analysis endpoint falls back to
# deterministic-only scoring (no AI assessment, aiAssessment: null).
ANTHROPIC_API_KEY=

# --- Phase 5: on-chain proposing (off by default, and safely so) ---
# The ONLY private key this codebase ever touches. Must be a bounded
# AGENT_ROLE key on GuardianVault — never the vault admin key. Holding this
# key grants exactly one capability: calling proposeTransaction(). It can
# NEVER approve or execute anything.
AGENT_PRIVATE_KEY=

# Explicit opt-in required in ADDITION to AGENT_PRIVATE_KEY. Both must be set
# (and GUARDIAN_VAULT_ADDRESS above) or the server refuses to boot with
# ENABLE_ONCHAIN_PROPOSE=true. Leave unset / false for analysis-only mode.
ENABLE_ONCHAIN_PROPOSE=false

MAX_EVENT_LOOKBACK_BLOCKS=2000
